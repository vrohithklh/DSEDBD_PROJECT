<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background">

    <!-- Reusable empty placeholder visual box -->
    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@android:drawable/ic_menu_today"
        android:backgroundTint="@color/muted_gray" />

    <TextView
        android:id="@+id/tv_empty_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="No Records Found"
        android:textColor="@color/on_background"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_empty_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="There are no items or attendance records to display at this moment."
        android:textColor="@color/muted_gray"
        android:textSize="14sp" />
</LinearLayout>
